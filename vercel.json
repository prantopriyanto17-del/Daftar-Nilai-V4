{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/exec",
      "destination": "/api/index"
    },
    {
      "source": "/exec/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
